#!/usr/bin/env python3
"""Drain Papervoice's durable post-call summary queue after token refresh."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from papervoice.vendors.paperclip import drain_pending_comments


if __name__ == "__main__":
    print(f"drained {drain_pending_comments()} pending Paperclip comment(s)")
