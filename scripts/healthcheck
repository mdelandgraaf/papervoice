#!/usr/bin/env python3
"""Papervoice healthcheck — run before every board call and after any dependency update.

Checks (per docs/ARCHITECTURE.md "Durability" rule 3 / PER-77), one per vendor surface
the system depends on:
  1. ElevenLabs TTS roundtrip: synthesize a short phrase, verify real audio comes back.
  2. ElevenLabs STT roundtrip: transcribe that audio back via Scribe.
  3. LiveKit room lifecycle: create a room, delete it.
  4. LiveKit room join: actually connect+disconnect a participant over WebRTC (not just
     the server-side room registry — this exercises the SFU handshake real calls use).
  5. LiveKit SIP trunk status: confirm the SIP API is reachable. Telephony is optional
     and not yet provisioned (see docs/ARCHITECTURE.md), so 0 configured trunks is healthy;
     this only catches the SIP API itself going unreachable or the SDK surface breaking.
  6. Boardroom voice roster: every static-fallback persona's voice_id still exists on the account.
  7. Live roster voices: every LIVE Paperclip-configured persona voice_id (metadata.papervoice.voice_id)
     will actually STREAM on this tier — the voices real calls use (PER-306/PER-311). Gates on
     streamability (category x subscription entitlement), not library presence or a REST synth:
     a professional/cloned voice can be listed and pass a REST roundtrip yet be rejected by the
     realtime WebSocket, leaving the agent silent on the call.
  8. Paperclip API reachability: a real authenticated call (Milestone 3), so a bad/expired
     PAPERCLIP_API_KEY or URL drift is caught here instead of during a call.
  9. Paperclip persona roster: every persona's bound paperclip_agent_id (personas.py)
     still exists in the company — catches an agent being renamed/removed/re-hired.
 10. Plugin setup complete (PER-415): every company the worker knows about has all three
     Setup panel rows green — LiveKit creds resolvable, boardroom identity secret ref
     resolvable, at least one enabled agent + moderator picked. Catches drift the
     Settings-page badge would show, so it fires before a board meeting rather than during.
 11. Plugin config reachable from worker (PER-415): for each known company, mint an
     HMAC-signed token exactly like mint-join-link does and call /boardroom-config —
     proves HMAC signing + secret resolution work end-to-end so the boardroom worker
     can actually fetch its per-company config at job start.

Exit code 0 = all green. Costs: two short TTS/STT calls (< $0.01), no LiveKit charges
(room create/delete/join and SIP trunk listing are free on LiveKit Cloud), one free
Paperclip API read.
"""

import asyncio
import sys
import time
import uuid
from pathlib import Path

import httpx

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from dotenv import load_dotenv

load_dotenv(Path(__file__).resolve().parent.parent / ".env")

from papervoice.personas import BOARDROOM_ROSTER
from papervoice.vendors import elevenlabs as el
from papervoice.vendors import livekit as lk
from papervoice.vendors import paperclip as pc


def check_elevenlabs_tts() -> str:
    t0 = time.monotonic()
    audio = el.tts_roundtrip()
    return f"voice {el.voice_id()}, {len(audio)} bytes in {time.monotonic() - t0:.2f}s"


def check_elevenlabs_stt() -> str:
    t0 = time.monotonic()
    text = el.stt_roundtrip()
    return f"transcribed {text!r} in {time.monotonic() - t0:.2f}s"


def check_livekit_room_lifecycle() -> str:
    async def run() -> str:
        # Unique name per run: LiveKit Cloud dedups room creation by name for a short
        # cooldown after deletion, so reusing a fixed name back-to-back can silently
        # no-op the create and 404 the delete. See PER-77.
        name = f"papervoice-healthcheck-{uuid.uuid4().hex[:8]}"
        t0 = time.monotonic()
        room = await lk.create_room(name)
        await lk.delete_room(name)
        return f"room {room.name!r} created+deleted in {time.monotonic() - t0:.2f}s"

    return asyncio.run(run())


def check_livekit_room_join() -> str:
    async def run() -> str:
        name = f"papervoice-healthcheck-{uuid.uuid4().hex[:8]}"
        t0 = time.monotonic()
        await lk.create_room(name)
        try:
            await lk.verify_room_join(name)
        finally:
            await lk.delete_room(name)
        return f"joined+disconnected room {name!r} in {time.monotonic() - t0:.2f}s"

    return asyncio.run(run())


def check_sip_trunk() -> str:
    return asyncio.run(lk.sip_trunk_status())


def check_boardroom_voices() -> str:
    available = el.list_voice_ids()
    missing = [p.identity for p in BOARDROOM_ROSTER if p.voice_id not in available]
    if missing:
        raise RuntimeError(f"voice_id missing from account for: {', '.join(missing)}")
    return f"{len(BOARDROOM_ROSTER)} persona voices present ({', '.join(p.display_name for p in BOARDROOM_ROSTER)})"


def check_live_roster_voices() -> str:
    """Every LIVE Paperclip-configured persona voice_id will actually STREAM on this tier.

    check_boardroom_voices above only covers the static BOARDROOM_ROSTER fallback;
    real calls use the live roster built from each agent's metadata.papervoice.voice_id
    (personas.load_roster_from_paperclip / _resolve_direct_persona). A voice that won't
    stream there makes the agent silent on a real call while the static check stays green.

    Crucially this gates on **streamability**, not library presence or a REST roundtrip.
    PER-306's P4Dhdy… ("Andy C", professional) is present in /voices AND synthesizes over
    REST (tts_roundtrip stays green), yet the realtime WebSocket rejects it with
    voice_id_does_not_exist because this payg tier can't stream professional voices
    (PER-311). streamability_report gates on category × subscription entitlement, so it
    catches exactly that here — in the check, not in a failed board meeting.
    """
    try:
        configs = pc.get_voice_enabled_agents()
    except Exception as exc:  # noqa: BLE001
        return f"skipped — Paperclip roster unreachable ({type(exc).__name__})"
    if not configs:
        return "no voice-enabled agents configured in Paperclip (nothing to check)"
    report = {vid: (category, streamable) for vid, category, streamable in el.streamability_report([c.voice_id for c in configs])}
    bad = []
    for c in configs:
        category, streamable = report[c.voice_id]
        if not streamable:
            reason = "not in account library" if category is None else f"category {category!r} not streamable on this tier"
            bad.append(f"{c.display_name} ({c.voice_id}: {reason})")
    if bad:
        raise RuntimeError(
            "live roster voice_id will not stream on the current ElevenLabs tier "
            "(realtime WebSocket TTS will reject; PER-311) for: " + ", ".join(bad)
        )
    return f"{len(configs)} live persona voice(s) streamable ({', '.join(c.display_name for c in configs)})"


def check_paperclip_api() -> str:
    t0 = time.monotonic()
    issues = pc.company_snapshot(limit=1)
    return f"reachable, {len(issues)} open issue(s) in top-priority snapshot in {time.monotonic() - t0:.2f}s"


def check_paperclip_persona_roster() -> str:
    bound = [p for p in BOARDROOM_ROSTER if p.paperclip_agent_id]
    if not bound:
        return "no persona bound to a Paperclip agent (nothing to check)"
    known = pc.list_agent_ids()
    missing = [p.identity for p in bound if p.paperclip_agent_id not in known]
    if missing:
        raise RuntimeError(f"paperclip_agent_id missing from company for: {', '.join(missing)}")
    return f"{len(bound)}/{len(BOARDROOM_ROSTER)} persona(s) bound to a live Paperclip agent"


# --- PER-415: plugin-side probes (setup panel + config route reachability) --

_SETTINGS_HINT = "open /company/settings/papervoice"


def _known_companies() -> dict[str, str]:
    """companyId -> pcp_ key for every company this worker would serve.

    Same map the multi-tenant boardroom entrypoint uses; empty when the worker
    has no PAPERCLIP_BOARDROOM_API_KEY / KEYS / JSON configured at all.
    """
    return pc.load_boardroom_key_map()


def _probe_setup_or_message(client: "pc.PaperclipClient") -> tuple[dict | None, str | None]:
    """Call probe-setup, return (body, None) on success or (None, message) on failure.

    Keeps the two probes from repeating the same HTTPStatusError translation:
    a 404 usually means the plugin isn't installed on this company; a 403 means
    the pcp_ key doesn't belong to that company; anything else surfaces the
    status code.
    """
    try:
        return client.probe_setup(), None
    except httpx.HTTPStatusError as exc:
        status = exc.response.status_code
        if status == 404:
            return None, (
                f"company {client.company_id}: plugin route not found "
                "(is the papervoice plugin installed for this company?)"
            )
        if status in (401, 403):
            return None, (
                f"company {client.company_id}: probe-setup rejected "
                f"(HTTP {status}) — pcp_ key may not belong to this company"
            )
        return None, f"company {client.company_id}: probe-setup HTTP {status}"
    except httpx.HTTPError as exc:
        return None, f"company {client.company_id}: probe-setup network error: {exc}"


def check_plugin_setup_complete() -> str:
    """Every company the worker knows about has all three Setup panel rows green.

    Reuses the plugin's own ``computeSetupStatus`` (evaluated server-side by the
    ``/probe-setup`` route) rather than reimplementing the checklist here, so
    the healthcheck's definition of "green" stays lock-step with the badge the
    board admin sees on the Settings page.
    """
    companies = _known_companies()
    if not companies:
        raise RuntimeError(
            "no companies configured for the boardroom worker — set "
            "PAPERCLIP_BOARDROOM_API_KEY (single-tenant) or "
            "PAPERCLIP_BOARDROOM_API_KEYS / _JSON (multi-tenant); "
            f"then {_SETTINGS_HINT}"
        )
    red: list[str] = []
    for company_id, api_key in companies.items():
        client = pc.PaperclipClient(company_id=company_id, api_key=api_key)
        body, err = _probe_setup_or_message(client)
        if err:
            red.append(err)
            continue
        rows = body.get("setup") or []
        bad_rows = [row for row in rows if row.get("status") != "ok"]
        if not bad_rows:
            continue
        # Name the exact missing piece per the acceptance criteria.
        parts = [f"{row.get('title', row.get('key'))}: {row.get('detail')}" for row in bad_rows]
        red.append(f"company {company_id}: {'; '.join(parts)} — {_SETTINGS_HINT}")
    if red:
        raise RuntimeError("; ".join(red))
    return f"{len(companies)} company(ies) fully set up"


def check_plugin_config_reachable_from_worker() -> str:
    """Mint HMAC token like mint-join-link, call /boardroom-config, verify pcp_ back.

    Exercises the exact code path the boardroom worker uses at job start
    (PaperclipClient.load_from_plugin), minus the LiveKit-metadata carrier —
    the token is minted directly by the plugin via probe-setup instead of
    stamped into a room. If this passes, both HMAC signing and every secret
    referenced by /boardroom-config resolve end-to-end.
    """
    companies = _known_companies()
    if not companies:
        raise RuntimeError(
            "no companies configured for the boardroom worker "
            f"— {_SETTINGS_HINT}"
        )
    failures: list[str] = []
    for company_id, api_key in companies.items():
        client = pc.PaperclipClient(company_id=company_id, api_key=api_key)
        body, err = _probe_setup_or_message(client)
        if err:
            failures.append(err)
            continue
        token_data = body.get("configToken")
        if not token_data:
            token_err = body.get("configTokenError") or "unknown"
            if token_err == "boardroom_config_hmac_secret_missing":
                failures.append(
                    f"company {company_id}: boardroomConfigHmacSecret not provisioned "
                    f"— {_SETTINGS_HINT} (the page auto-provisions it on first open)"
                )
            else:
                failures.append(f"company {company_id}: no config token ({token_err})")
            continue
        token = token_data.get("token")
        if not isinstance(token, str) or not token:
            failures.append(f"company {company_id}: probe-setup returned an empty token")
            continue
        try:
            config = client.fetch_boardroom_config(token)
        except httpx.HTTPStatusError as exc:
            status = exc.response.status_code
            error_body = None
            try:
                error_body = exc.response.json()
            except ValueError:
                pass
            code = (error_body or {}).get("error", "unknown")
            failures.append(
                f"company {company_id}: /boardroom-config HTTP {status} ({code}) — {_SETTINGS_HINT}"
            )
            continue
        except httpx.HTTPError as exc:
            failures.append(f"company {company_id}: /boardroom-config network error: {exc}")
            continue
        returned_key = config.get("boardroomApiKey", "") if isinstance(config, dict) else ""
        if not isinstance(returned_key, str) or not returned_key.startswith("pcp_"):
            failures.append(
                f"company {company_id}: /boardroom-config returned no valid pcp_ key "
                f"(resolved value did not start with 'pcp_') — {_SETTINGS_HINT}"
            )
    if failures:
        raise RuntimeError("; ".join(failures))
    return f"{len(companies)} company(ies) reachable + boardroomApiKey resolves to pcp_"


def main() -> int:
    failures = 0
    checks = (
        ("ElevenLabs TTS roundtrip", check_elevenlabs_tts),
        ("ElevenLabs STT roundtrip", check_elevenlabs_stt),
        ("LiveKit room lifecycle", check_livekit_room_lifecycle),
        ("LiveKit room join", check_livekit_room_join),
        ("LiveKit SIP trunk status", check_sip_trunk),
        ("Boardroom voice roster", check_boardroom_voices),
        ("Live roster voices", check_live_roster_voices),
        ("Paperclip API reachability", check_paperclip_api),
        ("Paperclip persona roster", check_paperclip_persona_roster),
        ("Plugin setup complete", check_plugin_setup_complete),
        ("Plugin config reachable from worker", check_plugin_config_reachable_from_worker),
    )
    for label, check in checks:
        try:
            detail = check()
            print(f"PASS  {label}: {detail}")
        except Exception as exc:  # noqa: BLE001 — report every vendor failure, don't crash the run
            failures += 1
            print(f"FAIL  {label}: {type(exc).__name__}: {exc}")
    print("healthcheck:", "ALL GREEN" if failures == 0 else f"{failures} FAILURE(S)")
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
