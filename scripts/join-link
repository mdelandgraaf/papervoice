#!/usr/bin/env python3
"""Print a browser join link for a Papervoice test call.

Usage: scripts/join-link [participant-name] [room]

Creates the room if needed, mints a 2-hour access token, and prints a
LiveKit Meet URL the board member can open in any browser (mic permission required).
"""

import asyncio
import os
import sys
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from dotenv import load_dotenv

load_dotenv(Path(__file__).resolve().parent.parent / ".env")

from papervoice.vendors import livekit as lk


def main() -> int:
    identity = sys.argv[1] if len(sys.argv) > 1 else "board-member"
    room = sys.argv[2] if len(sys.argv) > 2 else lk.DEFAULT_ROOM
    asyncio.run(lk.create_room(room))
    token = lk.mint_join_token(identity, room)
    url = "https://meet.livekit.io/custom?" + urllib.parse.urlencode(
        {"liveKitUrl": os.environ["LIVEKIT_URL"], "token": token}
    )
    print(f"Room:  {room}")
    print(f"Join as {identity!r} (valid 2h):\n{url}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
