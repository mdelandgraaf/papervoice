#!/usr/bin/env bash
set -euo pipefail

# Mandatory first action for every VoiceEngineer wake. The injected run JWT is
# copied into the local boardroom .env without ever printing it, then the
# boardroom worker is restarted (if no human is in the call) so it picks up the
# fresh token — load_dotenv() only fires at process startup, not on each call.
#
# Exit codes and ROUTINE: summary line (PER-151 filtering):
#   Exit 0 + "ROUTINE: NOMINAL"       — key refreshed, worker OK, nothing drained
#   Exit 0 + "ROUTINE: STATE_CHANGE"  — worker restarted and/or pending posts drained
#   Exit 1 + "ROUTINE: FAILED"        — worker could not start after restart attempt
#
# The agent reading this output should only file a follow-up Paperclip issue on
# FAILED, comment briefly on STATE_CHANGE, and mark done silently on NOMINAL.
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${PAPERCLIP_BOARDROOM_ENV_FILE:-$repo_dir/.env}"
: "${PAPERCLIP_API_KEY:?PAPERCLIP_API_KEY must be injected for wake refresh}"
: "${ELEVENLABS_API_KEY:?ELEVENLABS_API_KEY must be injected for wake refresh}"
mkdir -p "$(dirname "$env_file")"
tmp_file="$(mktemp "${env_file}.tmp.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT
if [[ -f "$env_file" ]]; then
  awk '!/^PAPERCLIP_API_KEY=/ && !/^ELEVENLABS_API_KEY=/' "$env_file" >"$tmp_file"
fi
printf 'PAPERCLIP_API_KEY=%s\n' "$PAPERCLIP_API_KEY" >>"$tmp_file"
printf 'ELEVENLABS_API_KEY=%s\n' "$ELEVENLABS_API_KEY" >>"$tmp_file"
chmod 600 "$tmp_file"
mv -f "$tmp_file" "$env_file"
echo "refreshed Paperclip boardroom token and ElevenLabs API key in $env_file"

# Track whether any notable state change occurred (PER-151 filtering).
worker_restarted=false

# Restart the worker so it picks up the new token. Skip if humans are in the
# call — a mid-call restart drops every participant immediately (PER-84).
worker_pid=$(pgrep -f 'python(3)? -m papervoice\.boardroom start' 2>/dev/null || true)
if [[ -z "$worker_pid" ]]; then
  echo "boardroom worker probe: NOT RUNNING — restarting" >&2
  need_restart=true
else
  echo "boardroom worker probe: running (pid $worker_pid)"
  room_occupied=$(
    PYTHONPATH="$repo_dir/src" \
      "$repo_dir/.venv/bin/python" -c "
import asyncio, sys
from dotenv import load_dotenv
load_dotenv('$env_file')
from papervoice.vendors import livekit as lk
from papervoice.personas import BOARDROOM_ROOM
result = asyncio.run(lk.room_has_human_participant(BOARDROOM_ROOM))
sys.stdout.write('true' if result else 'false')
" 2>/dev/null
  )
  if [[ "$room_occupied" == "true" ]]; then
    echo "boardroom worker: call in progress — skipping restart, new token loads on next call start"
    need_restart=false
  else
    echo "boardroom worker: room empty — restarting to pick up fresh token"
    need_restart=true
  fi
fi

# The LiveKit agents worker binds a health/metrics HTTP server on this port; a
# replacement that starts before the old worker releases it dies with
# "address already in use" (PER-174). Kept in a var so the free/verify checks
# below reference the same port the worker actually binds.
WORKER_HEALTH_PORT=8081
port_free() { ! ss -ltn 2>/dev/null | grep -q ":${WORKER_HEALTH_PORT}\b"; }

if [[ "$need_restart" == "true" ]]; then
  if [[ -n "$worker_pid" ]]; then
    # SIGTERM makes the LiveKit worker DRAIN (finish jobs, deregister) rather
    # than exit — during the drain (timeout 1800s) it keeps WORKER_HEALTH_PORT
    # bound, so a replacement launched too early fails to bind and silently
    # dies (PER-174). We already confirmed the room is empty above, so there's
    # nothing to drain gracefully: SIGTERM, then wait for the port to actually
    # free, escalating to SIGKILL if the drain won't release it in time.
    pkill -TERM -f 'python(3)? -m papervoice\.boardroom start' 2>/dev/null || true
    for _ in $(seq 1 8); do port_free && break; sleep 1; done
    if ! port_free; then
      echo "port ${WORKER_HEALTH_PORT} still held after SIGTERM — escalating to SIGKILL" >&2
      pkill -KILL -f 'python(3)? -m papervoice\.boardroom start' 2>/dev/null || true
      for _ in $(seq 1 8); do port_free && break; sleep 1; done
    fi
    if ! port_free; then
      echo "port ${WORKER_HEALTH_PORT} could not be freed — refusing to launch replacement" >&2
      echo "ROUTINE: FAILED (old worker would not release port ${WORKER_HEALTH_PORT})"
      exit 1
    fi
  fi
  # Run from /var/tmp/papervoice-boardroom (durable TMPDIR, see memory note PER-84)
  mkdir -p /var/tmp/papervoice-boardroom
  # Export vars from .env then launch; use env file directly via dotenv inside
  # the worker rather than xargs-expanding secrets onto the command line
  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  set +a
  nohup \
    env PYTHONPATH="$repo_dir/src" TMPDIR=/var/tmp/papervoice-boardroom \
    "$repo_dir/.venv/bin/python" -m papervoice.boardroom start \
    >> /var/tmp/papervoice-boardroom/worker.log 2>&1 &
  new_pid=$!
  # Deep liveness check: a bare `kill -0` passes even while the worker is still
  # dying from a bind failure (PER-174), so wait until the new pid is alive AND
  # it has bound WORKER_HEALTH_PORT AND LiveKit has confirmed "registered
  # worker" in the log — only that proves it will actually accept board calls.
  worker_ok=false
  for _ in $(seq 1 20); do
    sleep 1
    kill -0 "$new_pid" 2>/dev/null || break
    port_free && continue
    if tail -n 60 /var/tmp/papervoice-boardroom/worker.log 2>/dev/null \
         | grep -q '"registered worker"'; then
      worker_ok=true
      break
    fi
  done
  if [[ "$worker_ok" == "true" ]]; then
    echo "boardroom worker restarted (pid $new_pid), bound port ${WORKER_HEALTH_PORT} and registered"
    worker_restarted=true
  else
    echo "boardroom worker failed to start/register — check /var/tmp/papervoice-boardroom/worker.log" >&2
    echo "ROUTINE: FAILED (worker did not start after restart attempt)"
    exit 1
  fi
fi

# Drain only after refresh and probe, so queued posts use the current token.
drain_output=$(PYTHONPATH="$repo_dir/src" "$repo_dir/scripts/drain-pending-posts" 2>&1)
echo "$drain_output"
drained_count=$(printf '%s\n' "$drain_output" | grep -oE 'drained [0-9]+' | grep -oE '[0-9]+' || echo 0)

# Emit the PER-151 filter summary line so the agent can decide disposition.
state_parts=()
[[ "$worker_restarted" == "true" ]] && state_parts+=("worker restarted")
[[ "${drained_count:-0}" -gt 0 ]] && state_parts+=("drained $drained_count pending post(s)")
if [[ "${#state_parts[@]}" -gt 0 ]]; then
  summary=$(IFS=', '; echo "${state_parts[*]}")
  echo "ROUTINE: STATE_CHANGE ($summary)"
else
  echo "ROUTINE: NOMINAL (key refreshed, worker running, nothing drained)"
fi
