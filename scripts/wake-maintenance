#!/usr/bin/env bash
set -euo pipefail

# Worker liveness + credential persistence. Since PER-386/PER-388 delivered a
# durable, non-run-scoped Paperclip key (PAPERCLIP_BOARDROOM_API_KEY, a pcp_*
# agent key with no TTL), this no longer has to run on the every-25-min Paperclip
# routine to refresh a ~1h JWT — the durable key never expires. It now runs from a
# plain host cron (which creates NO Paperclip issues) purely to persist whatever
# credentials are present and keep the worker alive. It stays safe to invoke from a
# VoiceEngineer wake too: any injected secret present in the environment is written
# through to .env (durable key preferred, run JWT kept only as a dev fallback).
#
# Auth precedence (see vendors/paperclip.py::_api_key): the worker prefers the
# durable PAPERCLIP_BOARDROOM_API_KEY and falls back to the run-scoped
# PAPERCLIP_API_KEY only when the durable key is absent. A stale JWT left in .env is
# therefore harmless — it is never used while the durable key is present.
#
# Exit codes and ROUTINE: summary line (PER-151 filtering, still honoured by any
# agent-run invocation):
#   Exit 0 + "ROUTINE: NOMINAL"       — credentials in place, worker OK, nothing drained
#   Exit 0 + "ROUTINE: STATE_CHANGE"  — worker (re)started and/or pending posts drained
#   Exit 1 + "ROUTINE: FAILED"        — worker could not start after a restart attempt
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${PAPERCLIP_BOARDROOM_ENV_FILE:-$repo_dir/.env}"
mkdir -p "$(dirname "$env_file")"

# Persist any credential present in the environment through to .env, without ever
# printing it. Absent vars are left as-is in .env (host-cron runs inject nothing
# and rely on the durable key already persisted there). We require .env to end up
# holding at least one Paperclip credential so the worker can authenticate.
persist_env_var() {
  local name="$1" value
  value="$(printenv "$name" || true)"
  [[ -z "$value" ]] && return 0
  local tmp
  tmp="$(mktemp "${env_file}.tmp.XXXXXX")"
  if [[ -f "$env_file" ]]; then
    awk -v k="^${name}=" '$0 !~ k' "$env_file" >"$tmp"
  fi
  printf '%s=%s\n' "$name" "$value" >>"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$env_file"
}
persist_env_var PAPERCLIP_BOARDROOM_API_KEY
persist_env_var PAPERCLIP_API_KEY
persist_env_var ELEVENLABS_API_KEY

if [[ ! -f "$env_file" ]] || ! grep -qE '^(PAPERCLIP_BOARDROOM_API_KEY|PAPERCLIP_API_KEY)=.+' "$env_file"; then
  echo "no Paperclip credential in $env_file and none injected — cannot authenticate worker" >&2
  echo "ROUTINE: FAILED (no Paperclip credential available)"
  exit 1
fi
echo "persisted available credentials to $env_file (durable key preferred)"

# Load the persisted credentials into this shell so every downstream step works
# even when nothing is injected (the host-cron case): the room-occupancy probe and
# the pending-posts drain both authenticate from these values, not from an injected
# run environment. Safe pattern already used by the restart branch below.
set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

# Track whether any notable state change occurred (PER-151 filtering).
worker_restarted=false

# Restart ONLY for crash recovery. With the durable key there is no token to "pick
# up", so a healthy running worker is left completely alone — that is what removes
# the every-25-min restart churn (PER-386). A worker that is up keeps serving on the
# durable key it loaded at startup; the one-time migration onto the durable key is a
# deliberate manual restart, not something this liveness path forces.
worker_pid=$(pgrep -f 'python(3)? -m papervoice\.boardroom start' 2>/dev/null || true)
if [[ -z "$worker_pid" ]]; then
  echo "boardroom worker probe: NOT RUNNING — restarting for crash recovery" >&2
  need_restart=true
else
  echo "boardroom worker probe: running (pid $worker_pid) — leaving it alone (durable key, no refresh needed)"
  need_restart=false
fi

# The LiveKit agents worker binds a health/metrics HTTP server on this port; a
# replacement that starts before the old worker releases it dies with
# "address already in use" (PER-174). Kept in a var so the free/verify checks
# below reference the same port the worker actually binds.
WORKER_HEALTH_PORT=8081
port_free() { ! ss -ltn 2>/dev/null | grep -q ":${WORKER_HEALTH_PORT}\b"; }

# worker.log is unbounded debug output. A subprocess-spawn spin-loop (the PER-84
# forkserver flood, now fixed by the durable TMPDIR below) once wrote ~194k
# identical tracebacks and left 3.7 GB on disk. The durable TMPDIR stops that
# root cause, but nothing bounded the file itself, so we cap it: on each restart
# — after the old worker is dead, so no fd holds the file — roll the log aside if
# it exceeds this size, keeping one prior copy for forensics and starting fresh.
WORKER_DIR=/var/tmp/papervoice-boardroom
WORKER_LOG="$WORKER_DIR/worker.log"
WORKER_LOG_MAX_BYTES=$((200 * 1024 * 1024))  # 200 MiB

if [[ "$need_restart" == "true" ]]; then
  if [[ -n "$worker_pid" ]]; then
    # SIGTERM makes the LiveKit worker DRAIN (finish jobs, deregister) rather
    # than exit — during the drain (timeout 1800s) it keeps WORKER_HEALTH_PORT
    # bound, so a replacement launched too early fails to bind and silently
    # dies (PER-174). We already confirmed the room is empty above, so there's
    # nothing to drain gracefully: SIGTERM, then wait for the port to actually
    # free, escalating to SIGKILL if the drain won't release it in time.
    pkill -TERM -f 'python(3)? -m papervoice\.boardroom start' 2>/dev/null || true
    for _ in $(seq 1 8); do port_free && break; sleep 1; done
    if ! port_free; then
      echo "port ${WORKER_HEALTH_PORT} still held after SIGTERM — escalating to SIGKILL" >&2
      pkill -KILL -f 'python(3)? -m papervoice\.boardroom start' 2>/dev/null || true
      for _ in $(seq 1 8); do port_free && break; sleep 1; done
    fi
    if ! port_free; then
      echo "port ${WORKER_HEALTH_PORT} could not be freed — refusing to launch replacement" >&2
      echo "ROUTINE: FAILED (old worker would not release port ${WORKER_HEALTH_PORT})"
      exit 1
    fi
  fi
  # Run from the durable TMPDIR (see memory note PER-84) so the forkserver
  # socket survives run cleanup and the worker can spawn job subprocesses.
  mkdir -p "$WORKER_DIR"
  # Bound the debug log (see WORKER_LOG note): the old worker is dead here, so no
  # fd holds the file — roll it aside if oversized before starting fresh.
  if [[ -f "$WORKER_LOG" ]]; then
    log_bytes=$(stat -c %s "$WORKER_LOG" 2>/dev/null || echo 0)
    if (( log_bytes > WORKER_LOG_MAX_BYTES )); then
      mv -f "$WORKER_LOG" "$WORKER_LOG.1"
      echo "rolled oversized worker.log ($log_bytes bytes > ${WORKER_LOG_MAX_BYTES}B cap) to worker.log.1"
    fi
  fi
  # Credentials were already sourced into this shell above; the worker also calls
  # load_dotenv() itself at startup, so the child inherits them either way.
  nohup \
    env PYTHONPATH="$repo_dir/src" TMPDIR="$WORKER_DIR" \
    "$repo_dir/.venv/bin/python" -m papervoice.boardroom start \
    >> "$WORKER_LOG" 2>&1 &
  new_pid=$!
  # Deep liveness check: a bare `kill -0` passes even while the worker is still
  # dying from a bind failure (PER-174), so wait until the new pid is alive AND
  # it has bound WORKER_HEALTH_PORT AND LiveKit has confirmed "registered
  # worker" in the log — only that proves it will actually accept board calls.
  worker_ok=false
  for _ in $(seq 1 20); do
    sleep 1
    kill -0 "$new_pid" 2>/dev/null || break
    port_free && continue
    if tail -n 60 "$WORKER_LOG" 2>/dev/null \
         | grep -q '"registered worker"'; then
      worker_ok=true
      break
    fi
  done
  if [[ "$worker_ok" == "true" ]]; then
    echo "boardroom worker restarted (pid $new_pid), bound port ${WORKER_HEALTH_PORT} and registered"
    worker_restarted=true
  else
    echo "boardroom worker failed to start/register — check $WORKER_LOG" >&2
    echo "ROUTINE: FAILED (worker did not start after restart attempt)"
    exit 1
  fi
fi

# Drain only after credentials are loaded and the worker is probed, so queued
# posts authenticate with the durable key.
drain_output=$(PYTHONPATH="$repo_dir/src" "$repo_dir/scripts/drain-pending-posts" 2>&1)
echo "$drain_output"
drained_count=$(printf '%s\n' "$drain_output" | grep -oE 'drained [0-9]+' | grep -oE '[0-9]+' || echo 0)

# Emit the PER-151 filter summary line so the agent can decide disposition.
state_parts=()
[[ "$worker_restarted" == "true" ]] && state_parts+=("worker restarted")
[[ "${drained_count:-0}" -gt 0 ]] && state_parts+=("drained $drained_count pending post(s)")
if [[ "${#state_parts[@]}" -gt 0 ]]; then
  summary=$(IFS=', '; echo "${state_parts[*]}")
  echo "ROUTINE: STATE_CHANGE ($summary)"
else
  echo "ROUTINE: NOMINAL (durable key in place, worker running, nothing drained)"
fi
