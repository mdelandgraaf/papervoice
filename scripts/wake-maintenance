#!/usr/bin/env bash
set -euo pipefail

# Mandatory first action for every VoiceEngineer wake. The injected run JWT is
# copied into the local boardroom .env without ever printing it.
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${PAPERCLIP_BOARDROOM_ENV_FILE:-$repo_dir/.env}"
: "${PAPERCLIP_API_KEY:?PAPERCLIP_API_KEY must be injected for wake refresh}"
mkdir -p "$(dirname "$env_file")"
tmp_file="$(mktemp "${env_file}.tmp.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT
if [[ -f "$env_file" ]]; then
  awk '!/^PAPERCLIP_API_KEY=/' "$env_file" >"$tmp_file"
fi
printf 'PAPERCLIP_API_KEY=%s\n' "$PAPERCLIP_API_KEY" >>"$tmp_file"
chmod 600 "$tmp_file"
mv -f "$tmp_file" "$env_file"
echo "refreshed Paperclip boardroom token in $env_file"

if ! pgrep -f 'python(3)? -m papervoice\.boardroom start' >/dev/null; then
  echo "boardroom worker probe: NOT RUNNING" >&2
  exit 1
fi
echo "boardroom worker probe: running"

# Drain only after refresh and probe, so queued posts use the current token.
PYTHONPATH="$repo_dir/src" "$repo_dir/scripts/drain-pending-posts"
