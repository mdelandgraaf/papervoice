# Copy to .env and fill in. Never commit .env (gitignored).
# The board (via CEO) provisions all paid accounts — see docs/ARCHITECTURE.md.

# ElevenLabs — TTS (and Scribe STT). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice for the M1 agent. Default is the premade "Rachel" voice, available on every account.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# LiveKit Cloud project — https://cloud.livekit.io (Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM for the agent persona
ANTHROPIC_API_KEY=

# Paperclip control plane — standup context/actions (Milestone 3). The worker's
# credential for its own Paperclip agent identity, not a new vendor account; see
# docs/ARCHITECTURE.md "Required accounts & secrets" and M3 notes point 7.
#
# PAPERCLIP_BOARDROOM_API_KEY is the durable, non-run-scoped board-minted key
# (pcp_*, no TTL, delivered on PER-388). It is PREFERRED — the long-running worker
# authenticates from it for its whole lifetime, so no token refresh is ever needed.
# PAPERCLIP_API_KEY (a run-scoped ~1h JWT) is only a dev-shell fallback used when
# the durable key is absent. In production only the durable key needs to be set.
PAPERCLIP_API_URL=
PAPERCLIP_BOARDROOM_API_KEY=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
# Optional: issue id to post the post-call summary comment to. Leave unset to
# skip posting a summary (the standup still runs and can still file issues live).
PAPERCLIP_STANDUP_SUMMARY_ISSUE_ID=

# --- Multi-tenant Papervoice (PER-405) ---
# One worker process can serve calls for multiple Paperclip companies (each
# with its own papervoice-enabled agents). The plugin stamps companyId into
# LiveKit room metadata when minting a join link; the worker resolves the
# right per-company API key at job start from the config below.
#
# Recommended: paste each company's pcp_* key into PAPERCLIP_BOARDROOM_API_KEYS
# (comma-separated). The worker calls GET /api/agents/me for each key on
# startup to discover which company it belongs to — no UUIDs to look up.
#PAPERCLIP_BOARDROOM_API_KEYS=pcp_company_a,pcp_company_b,pcp_company_c
#
# Legacy / advanced sources (still supported; JSON wins on conflicts, so you
# can rotate one company's key without touching the shared list):
#   * PAPERCLIP_BOARDROOM_API_KEY_<UUID_WITH_UNDERSCORES>=pcp_...
#     e.g. for companyId 8126b511-8dd2-4fa0-8a4f-22d630b83108 the var is
#     PAPERCLIP_BOARDROOM_API_KEY_8126B511_8DD2_4FA0_8A4F_22D630B83108
#   * PAPERCLIP_BOARDROOM_KEYS_JSON=/etc/papervoice/boardroom-keys.json
#     JSON file shaped { "<companyId>": "pcp_...", ... }
#
# The primary company (PAPERCLIP_COMPANY_ID + PAPERCLIP_BOARDROOM_API_KEY
# above) is always included as the fallback for calls whose room metadata
# omits companyId — so single-tenant deployments need no changes.
