+  it.each([
+    ["absent", undefined, { verified: false, code: "missing_token" }, 401],
+    ["invalid", "not-a-token", { verified: false, code: "invalid_token" }, 401],
+    ["expired", "expired-token", { verified: false, code: "expired_token" }, 401],
+    ["cross-company", "other-company-token", { verified: false, status: 403, code: "company_mismatch" }, 403],
+  ])("rejects %s webhook credentials before handler dispatch", async (_label, token, verificationResult, status) => {
+    const apiRoutes = manifest([{
+      routeKey: "boardroom-config",
+      method: "GET",
+      path: "/boardroom-config",
+      auth: "webhook",
+      capability: "api.routes.register",
+      companyResolution: { from: "query", key: "companyId" },
+    }]);
+    const { app, workerManager } = await createApp({
+      actor: { type: "anonymous", source: "none" },
+      plugin: { id: pluginId, pluginKey: apiRoutes.id, status: "ready", manifestJson: apiRoutes },
+      verificationResult,
+    });
+
+    let call = request(app).get(`/api/plugins/${pluginId}/api/boardroom-config?companyId=${companyId}&room=test-room`);
+    if (token) call = call.set("Authorization", `Bearer ${token}`);
+    const res = await call;
+
+    expect(res.status).toBe(status);
+    expect(workerManager.call).toHaveBeenCalledTimes(1);
+    expect(workerManager.call).toHaveBeenCalledWith(pluginId, "verifyApiRequest", expect.objectContaining({
+      routeKey: "boardroom-config",
+      companyId,
+      query: { companyId, room: "test-room" },
+      headers: expect.objectContaining(token ? { authorization: `Bearer ${token}` } : {}),
+    }));
+  });
+
+  it("dispatches a verified webhook request with original query and sanitized headers", async () => {
+    const apiRoutes = manifest([{
+      routeKey: "boardroom-config",
+      method: "GET",
+      path: "/boardroom-config",
+      auth: "webhook",
+      capability: "api.routes.register",
+      companyResolution: { from: "query", key: "companyId" },
+    }]);
+    const { app, workerManager } = await createApp({
+      actor: { type: "anonymous", source: "none" },
+      plugin: { id: pluginId, pluginKey: apiRoutes.id, status: "ready", manifestJson: apiRoutes },
+      verificationResult: { verified: true },
+      workerResult: { status: 200, body: { joined: true } },
+    });
+
+    const res = await request(app)
+      .get(`/api/plugins/${pluginId}/api/boardroom-config?companyId=${companyId}&room=test-room`)
+      .set("Authorization", "Bearer valid-token")
+      .set("X-Request-Id", "request-1");
+
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({ joined: true });
+    expect(workerManager.call).toHaveBeenCalledTimes(2);
+    expect(workerManager.call).toHaveBeenLastCalledWith(pluginId, "handleApiRequest", expect.objectContaining({
+      query: { companyId, room: "test-room" },
+      headers: expect.objectContaining({ "x-request-id": "request-1" }),
+    }));
+    expect(workerManager.call.mock.calls[1]?.[2].headers.authorization).toBeUndefined();
+  });
+
+  it("fails closed when a webhook verifier is missing or throws", async () => {
+    const apiRoutes = manifest([{
+      routeKey: "boardroom-config",
+      method: "GET",
+      path: "/boardroom-config",
+      auth: "webhook",
+      capability: "api.routes.register",
+      companyResolution: { from: "query", key: "companyId" },
+    }]);
+    const { app, workerManager } = await createApp({
+      actor: { type: "anonymous", source: "none" },
+      plugin: { id: pluginId, pluginKey: apiRoutes.id, status: "ready", manifestJson: apiRoutes },
+    });
+    workerManager.call.mockRejectedValueOnce(new Error("method not implemented"));
+
+    const res = await request(app)
+      .get(`/api/plugins/${pluginId}/api/boardroom-config?companyId=${companyId}`);
+
+    expect(res.status).toBe(401);
+    expect(workerManager.call).toHaveBeenCalledTimes(1);
+  });
+
